# Copy to .env and fill in secrets (never commit .env).
# Loaded automatically by dotenv when you run `pnpm run dev` from this directory.

# --- Required (JWT signing) ---
ACCESS_TOKEN_SECRET=replace-with-long-random-string
REFRESH_TOKEN_SECRET=replace-with-different-long-random-string

# --- HTTP ---
# PORT=6001

# --- Google OAuth (optional; leave blank to disable Google login) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:6001/api/users/google/callback

# --- Auth redirects ---
# CLIENT_REDIRECT_BASE=http://localhost:3000

# --- Email (password reset) ---
# MAIL_FROM=Rebound <no-reply@your-domain.com>
# PASSWORD_RESET_FROM=Rebound <no-reply@your-domain.com>
# PASSWORD_RESET_URL_BASE=https://your-domain.com
# EMAIL_DISABLED=false
# EMAIL_REQUIRED=false
#
# SES is preferred when a region is configured. AWS credentials are read by the AWS SDK
# default chain, including AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY or an IAM role.
# AWS_SES_REGION=us-east-1
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# PASSWORD_RESET_SES_CONFIGURATION_SET=
#
# SMTP remains available as a fallback when SES is not configured.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# --- CORS (comma-separated; omit to use server defaults) ---
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Production MongoDB (ignored in development; dev uses mongodb-memory-server) ---
# DB_USER=
# DB_PASS=
# DB_NAME=
# DB_AUTH=admin

# --- Live ingest / HLS (optional overrides) ---
# LIVE_INGEST_CREATE_TOKEN=
# LIVE_STORAGE_BACKEND=
# LIVE_STORAGE_DIR=./live-storage
# LIVE_SESSION_TTL_MS=90000
# LIVE_CLEANUP_INTERVAL_MS=15000
# LIVE_ENDED_RETENTION_MS=30000
# LIVE_HEARTBEAT_INTERVAL_MS=15000
# LIVE_MAX_RETAINED_SEGMENTS=5
# LIVE_MAX_RETAINED_SEGMENTS_CAP=10
# LIVE_MAX_PLAYLIST_BYTES=262144
# LIVE_MAX_SEGMENT_BYTES=67108864
# LIVE_SEGMENT_CACHE_SECONDS=300
# LIVE_S3_BUCKET=
# LIVE_S3_REGION=us-east-1
# LIVE_S3_PREFIX=live
# LIVE_S3_ENDPOINT=
# LIVE_S3_FORCE_PATH_STYLE=false
