server {
    if ($host = rebound.nexus) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    if ($host = www.rebound.nexus) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    listen [::]:80;
    server_name www.rebound.nexus rebound.nexus;
    return 404; # managed by Certbot
}
