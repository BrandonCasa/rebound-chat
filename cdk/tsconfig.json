{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"noEmit": true,
		"types": ["node", "vitest/globals"]
	},
	"include": ["bin/**/*.ts", "lib/**/*.ts", "test/**/*.ts"]
}
